# Wim-maatje configuratie
PORT=3100

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optioneel: ander model (standaard gpt-5.4-mini)
# OPENAI_MODEL=gpt-5.4-mini

# --- Google Calendar-koppeling (agenda) ---
# Aanmaken in Google Cloud Console (zie docs/agenda-connector.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Moet exact overeenkomen met de redirect-URI in de Google Cloud Console.
# Lokaal: http://localhost:3100/api/google/callback
# Op een server: https://JOUW-DOMEIN/api/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3100/api/google/callback

# --- Pushmeldingen ---
# Contactadres voor VAPID (mag je eigen e-mail zijn). VAPID-sleutels worden
# automatisch gegenereerd en in data/db.json bewaard.
PUSH_CONTACT=mailto:jij@voorbeeld.nl

# --- Hosting ---
# Alleen op een server: pad naar een persistente schijf zodat tokens/meldingen
# een herstart overleven. Lokaal leeg laten (dan wordt ./data gebruikt).
# WIM_DATA_DIR=/data
